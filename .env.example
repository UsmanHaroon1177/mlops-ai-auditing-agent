# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Primary model (default: gemini-flash-lite-latest, the most generous free tier).
GEMINI_MODEL=gemini-flash-lite-latest
# Optional. Comma-separated models used when the primary hits its DAILY free quota or is unavailable.
GEMINI_FALLBACK_MODELS=gemini-flash-latest
# Optional. Minimum seconds between LLM calls (4.5 keeps you under ~13 requests/minute).
GEMINI_MIN_INTERVAL_SEC=4.5
